[project]
title = The True Path
version = 0.1.0

[bootstrap]
render = /render/game.renderc
main_collection = /main/main.collectionc

[input]
game_binding = /input/game.input_bindingc
repeat_interval = 0.0

[display]
width = 1280
height = 720
high_dpi = 1

[physics]
type = 2D
gravity_y = 0.0
use_fixed_timestep = 1

[script]
shared_state = 1

[html5]
scale_mode = stretch
show_fullscreen_button = 0
show_made_with_defold = 0
heap_size = 128
wasm_streaming = 1
cssfile = /web/game.css

[render]
clear_color_red = 0.043
clear_color_green = 0.067
clear_color_blue = 0.102
clear_color_alpha = 1.0
