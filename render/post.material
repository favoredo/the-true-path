name: "post"
tags: "composite"
vertex_program: "/render/world.vp"
fragment_program: "/render/post.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants { name: "view_proj" type: CONSTANT_TYPE_VIEWPROJ }
samplers { name: "scene_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
samplers { name: "mask_texture" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
fragment_constants { name: "light" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "camera_info" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
fragment_constants { name: "view_size" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
