local maze=require 'game.maze'
local state=require 'game.game_state'
local input=require 'game.input_state'
local visibility=require 'game.visibility'
local geometry=require 'game.geometry'
local TILE,RADIUS,MOVE_TIME=160,300,0.18
local names={'up','right','down','left'}
local actions={}
for _,n in ipairs(names) do actions[hash('move_'..n)]=n;actions[hash('arrow_'..n)]=n end
local frames={up=0,right=1,down=2,left=3}
local offsets={up={32,44},right={35,35},down={-28,29},left={-36,32}}
local function position(row,col) return (col-0.5)*TILE,(maze.height()-row+0.5)*TILE end
local function upload(name,v) geometry.upload('/render/'..name..'.bufferc',v) end
local function build_level(self)
 local terrain,decor={},{}
 for r=1,maze.height() do for c=1,maze.width() do
  local x,y=position(r,c);local walk=maze.is_walkable(r,c)
  geometry.quad(terrain,x,y,TILE,TILE,-2,walk and (1+(r*7+c*3)%4) or (5+(r+c)%4))
  if walk then
   if not maze.is_walkable(r,c-1) then geometry.quad(decor,x-85,y,78,164,-1.5,5+(r%4)) end
   if not maze.is_walkable(r,c+1) then geometry.quad(decor,x+85,y,78,164,-1.5,5+(r%4)) end
   if not maze.is_walkable(r-1,c) then geometry.quad(decor,x,y+83,160,64,-1.5,5) end
   if not maze.is_walkable(r+1,c) then geometry.quad(decor,x,y-83,160,64,-1.5,6) end
   -- Border foliage remains clear of the 80-unit walking lane.
   if not maze.is_walkable(r,c-1) and (r+c)%2==0 then geometry.quad(decor,x-68,y,82,110,-1,r>11 and (9+r%2) or 11) end
   if not maze.is_walkable(r,c+1) and (r+c)%3==0 then geometry.quad(decor,x+68,y+22,95,116,-1,r>11 and 12 or 11) end
  end
 end end
 local x,y=position(10,4);geometry.quad(decor,x,y+40,150,150,-0.5,13)
 x,y=position(2,8);geometry.quad(decor,x,y,100,120,-0.5,14)
 upload('terrain',terrain);upload('decor',decor)
 local post={};geometry.quad(post,0,0,2,2,0,1,1,1)
 -- Fullscreen sampling must include exact 0..1 edges.
 for _,v in ipairs(post) do v[4]=(v[1]+1)/2;v[5]=(v[2]+1)/2 end
 upload('post',post)
end
local function publish(self)
 if not html5 then return end
 local s=state.snapshot(self.model)
 html5.run('window.__THE_TRUE_PATH_STATE__=Object.freeze('..json.encode({status=s.status,row=s.row,col=s.col,blocked_count=s.blocked_count,win_count=s.win_count,moving=self.moving,hero_x=self.x,hero_y=self.y,camera_x=self.x,camera_y=self.y,torch_x=self.tx,torch_y=self.ty,radius=RADIUS,direction=self.direction,version='003'})..');')
end
local function render_player(self)
 local o=offsets[self.direction];self.tx,self.ty=self.x+o[1],self.y+o[2]
 local frame=self.moving and math.floor(self.time*9)%4 or 0
 local vertices={};geometry.quad(vertices,self.x,self.y,136,136,0,frames[self.direction]*4+frame+1)
 upload('hero',vertices)
 local fire={};local height=19+2*math.sin(self.time*12)
 geometry.quad(fire,self.tx,self.ty+height/2,14,height,1,1,1,1)
 for _,v in ipairs(fire) do v[4]=(v[1]-self.tx+7)/14;v[5]=(v[2]-self.ty)/height end
 upload('fire',fire)
 if self.last_tx~=self.tx or self.last_ty~=self.ty then
  local points=visibility.polygon(self.tx,self.ty,self.edges,RADIUS,12);local triangles={}
  for i,p in ipairs(points) do local q=points[i%#points+1]
   triangles[#triangles+1]={self.tx,self.ty,0};triangles[#triangles+1]={p[1],p[2],0};triangles[#triangles+1]={q[1],q[2],0}
  end
  upload('mask',triangles);self.last_tx,self.last_ty=self.tx,self.ty
 end
 msg.post('@render:','scene_view',{camera=vmath.vector3(self.x,self.y,0),light=vmath.vector4(self.tx,self.ty,RADIUS,1+0.015*math.sin(self.time*7))})
end
local function restart(self)
 state.reset(self.model);input.clear(self.input);self.moving=false;self.direction='up'
 local s=state.snapshot(self.model);self.x,self.y=position(s.row,s.col)
 self.block_until=0;msg.post('/hud#gui','show_playing');msg.post('/hud#gui','clear_input')
 render_player(self);publish(self)
end
local function attempt(self,direction)
 self.direction=direction
 local result=state.move(self.model,direction)
 if result.kind=='ignored' then return end
 if result.kind=='blocked' then
  self.block_until=self.time+0.3;sound.play('#blocked');return
 end
 self.from_x,self.from_y=self.x,self.y;self.to_x,self.to_y=position(result.state.row,result.state.col)
 self.progress=0;self.moving=true;self.pending_win=result.kind=='won'
end
function init(self)
 maze.validate();self.model=state.new(maze);self.input=input.new();self.edges=visibility.edges(maze,TILE);self.time=0
 self.browser_cancel=0;self.browser_size=''
 if html5 then html5.run([[window.__ttpCancel=0;window.__ttpTouch=false;
 ['blur','pagehide'].forEach(function(e){window.addEventListener(e,function(){window.__ttpCancel++;});});
 document.addEventListener('visibilitychange',function(){if(document.hidden)window.__ttpCancel++;});
 window.addEventListener('touchcancel',function(e){
  window.__ttpCancel++;
  // Defold 1.13.1's generated handler calls preventDefault even for a
  // non-cancelable touchcancel. Guard this event instance, preserving delivery.
  if(!e.cancelable)e.preventDefault=function(){};
 },true);
 window.addEventListener('pointerup',function(e){if(e.target!==document.querySelector('canvas'))window.__ttpCancel++;},true);
 window.addEventListener('pointercancel',function(){window.__ttpCancel++;});
 window.addEventListener('touchstart',function(){window.__ttpTouch=true;},{passive:true});
 window.addEventListener('resize',function(){window.__ttpCancel++;});
 ]]) end
 build_level(self);msg.post('.','acquire_input_focus');restart(self)
 window.set_listener(function(_,event)
  if event==window.WINDOW_EVENT_FOCUS_LOST or event==window.WINDOW_EVENT_RESIZED then input.clear(self.input);msg.post('/hud#gui','clear_input') end
 end)
end
function update(self,dt)
 self.time=self.time+dt
 if html5 then
  local n=tonumber(html5.run('String(window.__ttpCancel||0)')) or 0
  if n~=self.browser_cancel then self.browser_cancel=n;input.clear(self.input);msg.post('/hud#gui','clear_input') end
 end
 if self.moving then
  self.progress=math.min(1,self.progress+dt/MOVE_TIME)
  self.x=self.from_x+(self.to_x-self.from_x)*self.progress;self.y=self.from_y+(self.to_y-self.from_y)*self.progress
  if self.progress==1 then
   self.moving=false
   if self.pending_win then input.clear(self.input);sound.play('#victory');msg.post('/hud#gui','show_victory') end
  end
 end
 if not self.moving and self.model.status~='won' and self.time>=self.block_until then
  local d=input.direction(self.input);if d then attempt(self,d) end
 end
 render_player(self);publish(self)
end
function on_input(self,id,action)
 if id==hash('restart') and action.pressed then restart(self);return true end
 local d=actions[id]
 if d then
  if action.pressed then input.press(self.input,id,d);self.block_until=0 end
  if action.released then input.release(self.input,id) end
  return true
 end
 return false
end
function on_message(self,id,m)
 if id==hash('direction_press') then input.press(self.input,m.source,m.direction);self.block_until=0
 elseif id==hash('direction_release') then input.release(self.input,m.source)
 elseif id==hash('restart_request') then restart(self) end
end
function final(self) window.set_listener(nil);msg.post('.','release_input_focus') end
